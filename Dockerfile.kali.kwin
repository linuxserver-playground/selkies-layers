# syntax=docker/dockerfile:1

FROM ghcr.io/linuxserver-playground/baseimage-debian:kali AS kwin-builder

# Retry failed apt downloads: Kali's CDN mirrors drop connections mid-fetch.
RUN echo 'Acquire::Retries "5";' > /etc/apt/apt.conf.d/80-retries

ARG DISTRO_VERSION
ARG DEBIAN_FRONTEND=noninteractive

COPY patches/kali/${DISTRO_VERSION}/kwin/ /build/patches/

RUN \
  echo "**** enable source repos ****" && \
  if ! grep -rqs "^deb-src" /etc/apt/sources.list /etc/apt/sources.list.d/; then \
    sed -n 's/^deb /deb-src /p' /etc/apt/sources.list >> /etc/apt/sources.list; \
  fi && \
  apt-get update && \
  echo "**** install build deps ****" && \
  apt-get install --no-install-recommends -y \
    ca-certificates \
    dpkg-dev && \
  apt-get build-dep -y kwin && \
  echo "**** build patched kwin targets ****" && \
  mkdir -p /build/src && \
  cd /build/src && \
  apt-get source kwin && \
  cd kwin-*/ && \
  for kwin_patch in /build/patches/*.patch; do \
    [ -e "${kwin_patch}" ] || continue; \
    echo "applying $(basename "${kwin_patch}")" && \
    patch -p1 < "${kwin_patch}"; \
  done && \
  export DEB_BUILD_MAINT_OPTIONS="hardening=+all" && \
  export DEB_BUILD_OPTIONS="nocheck parallel=$(nproc)" && \
  dh_auto_configure -- \
    -DBUILD_TESTING=OFF \
    -DQTWAYLANDSCANNER_KDE_EXECUTABLE=/usr/lib/qt6/libexec/qtwaylandscanner && \
  dh_auto_build -- \
    kwin \
    screencast && \
  echo "**** stage layer ****" && \
  LIBDIR=/buildout/usr/lib/$(dpkg-architecture -qDEB_HOST_MULTIARCH) && \
  mkdir -p \
    ${LIBDIR}/qt6/plugins/kwin/plugins && \
  cp \
    $(find obj-* -name 'libkwin.so.6.*' -type f) \
    ${LIBDIR}/ && \
  cp \
    $(find obj-* -name 'screencast.so' -type f) \
    ${LIBDIR}/qt6/plugins/kwin/plugins/ && \
  strip --strip-unneeded \
    --remove-section=.comment \
    --remove-section=.note \
    ${LIBDIR}/libkwin.so.6.* \
    ${LIBDIR}/qt6/plugins/kwin/plugins/screencast.so

FROM scratch
COPY --from=kwin-builder /buildout/ /
