+static std::optional<DmaBufAttributes> importableAttributes(const ShmAttributes *attributes)
+{
+    if (auto udmabuf = GpuManager::self()->createUdmabuf(attributes)) {
+        return udmabuf;
+    }
+    // without /dev/udmabuf, the memfd software renderer maps the client's memfd itself
+    return GpuManager::self()->createMemfdDmabuf(attributes);
+}
