+GraphicsBuffer *UDmabufAllocator::allocate(const GraphicsBufferOptions &options)
+{
+    if (!options.modifiers.contains(DRM_FORMAT_MOD_LINEAR)) {
+        return nullptr;
+    }
+    return allocateBuffer(options.format, options.size, false);
+}
+
+GraphicsBuffer *UDmabufAllocator::allocate(uint32_t format, const QSize &size)
+{
+    return allocateBuffer(format, size, false);
+}
+
+GraphicsBuffer *MemfdDmabufAllocator::allocate(const GraphicsBufferOptions &options)
+{
+    if (!options.modifiers.contains(DRM_FORMAT_MOD_LINEAR)) {
+        return nullptr;
+    }
+    return allocateBuffer(options.format, options.size, true);
